# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel
# (Project Settings > Environment Variables). NUNCA commite valores reais.

# turso db show neon-arcade --url
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io

# turso db tokens create neon-arcade
TURSO_AUTH_TOKEN=cole-o-token-aqui
